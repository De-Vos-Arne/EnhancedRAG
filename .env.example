# Copy to .env and edit. Every line is optional — the defaults work.

# ── Paths (relative to the project root) ──
# RAG_ARCHIVE=data/PersonalArchive.rnt
# RAG_CORPUS_DB=data/corpus.db
# RAG_RESULTS_DB=results/eval.db

# ── Models ──
# Named presets live in src/enhanced_rag/settings.py.
# RAG_GENERATOR=lmstudio           # local-qwen | local-llama | deepseek | openai-compatible | lmstudio | openrouter
# RAG_EMBEDDER=nomic               # nomic | minilm | mxbai
# OLLAMA_URL=http://localhost:11434
# RAG_LOCAL_MODEL=qwen2.5:7b-instruct
# RAG_CTX_QWEN=8192                # num_ctx actually requested from Ollama —
# RAG_CTX_LLAMA=8192               # raise if you have VRAM headroom; Ollama
#                                   # silently truncates past this otherwise.

# Needed only if you select the deepseek generator:
# DEEPSEEK_API_KEY=sk-...
# RAG_CTX_DEEPSEEK=64000

# Or any other OpenAI-compatible endpoint:
# RAG_GEN_BASE_URL=https://api.example.com/v1
# RAG_GEN_API_KEY=...
# RAG_GEN_MODEL=some-model
# RAG_CTX_OPENAI=128000

# LM Studio (local server, Settings > Developer > enable local server):
# RAG_LMSTUDIO_URL=http://localhost:1234/v1
# RAG_LMSTUDIO_MODEL=local-model   # exact name from LM Studio's server tab
# RAG_CTX_LMSTUDIO=32768           # match what LM Studio reports for the
#                                   # loaded model, not the architecture max

# OpenRouter (proxies many providers behind one API):
# RAG_OPENROUTER_API_KEY=sk-or-...
# RAG_OPENROUTER_MODEL=deepseek/deepseek-chat   # exact slug from openrouter.ai/models
# RAG_CTX_OPENROUTER=64000

# ── Server ──
# RAG_HOST=127.0.0.1
# RAG_PORT=5000
# RAG_ARCHIVE_READONLY=0           # 1 blocks all writes to the .rnt
